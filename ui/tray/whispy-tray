#!/usr/bin/env python3
"""
whispy-tray: System tray indicator for the whispy dictation daemon.
Integrates with the freedesktop StatusNotifierItem (SNI) DBus specification
(supported by Noctalia, Waybar, KDE Plasma, XFCE, Polybar, etc.).

Monitors $XDG_RUNTIME_DIR/whispy/state.json and dynamically updates
the tray icon and tooltip based on the current dictation state:
  - idle: microphone (ready)
  - recording: ear (listening)
  - transcribing: brain (GPU inference)
  - error: microphone-off / warning
"""

import json
import os
import signal
import subprocess
import sys
import warnings

warnings.filterwarnings("ignore", category=DeprecationWarning)

try:
    import gi
    gi.require_version("Gio", "2.0")
    gi.require_version("Rsvg", "2.0")
    from gi.repository import Gio, GLib, Rsvg
except ImportError as err:
    sys.stderr.write(
        f"whispy-tray error: missing required dependencies ({err}).\n"
        "Please ensure python-gobject and librsvg are installed.\n"
    )
    sys.exit(1)

SNI_XML = """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="IconPixmap" type="a(iiay)" access="read"/>
    <property name="IconThemePath" type="s" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
    <method name="ContextMenu">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
    </method>
    <method name="Activate">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
    </method>
    <method name="SecondaryActivate">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
    </method>
    <method name="Scroll">
      <arg name="delta" type="i" direction="in"/>
      <arg name="orientation" type="s" direction="in"/>
    </method>
    <signal name="NewIcon"/>
    <signal name="NewToolTip"/>
    <signal name="NewStatus">
      <arg name="status" type="s"/>
    </signal>
  </interface>
</node>
"""

class WhispyTray:
    def __init__(self):
        self.state_file = os.path.join(
            os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"),
            "whispy",
            "state.json"
        )
        self.current_state = "idle"
        self.conn = None

        # Resolve icon directory
        self.icon_dir = self.resolve_icon_dir()

        # Pre-render pixmaps for crisp vector rendering in Qt / Quickshell
        self.pixmaps = {}
        for state_key, filename in [
            ("idle", "whispy-idle.svg"),
            ("recording", "whispy-recording.svg"),
            ("transcribing", "whispy-transcribing.svg"),
            ("error", "whispy-error.svg"),
        ]:
            path = self.resolve_icon_file(filename)
            self.pixmaps[state_key] = self.render_svg_pixmap(path, 24, 24)

        self.icon_name, self.tooltip_text = self.get_icon_and_tooltip("idle")

    def resolve_icon_dir(self):
        script_dir = os.path.dirname(os.path.abspath(__file__))
        candidates = [
            os.path.join(script_dir, "icons"),
            os.path.expanduser("~/.local/share/icons/hicolor/scalable/apps"),
            os.path.expanduser("~/.local/share/whispy/icons"),
            "/usr/local/share/icons/hicolor/scalable/apps",
            "/usr/share/icons/hicolor/scalable/apps",
            "/usr/share/whispy/icons",
        ]
        for c in candidates:
            if os.path.isdir(c):
                return c
        return script_dir

    def resolve_icon_file(self, filename):
        script_dir = os.path.dirname(os.path.abspath(__file__))
        candidates = [
            os.path.join(script_dir, "icons", filename),
            os.path.join(script_dir, filename),
            os.path.expanduser(f"~/.local/share/icons/hicolor/scalable/apps/{filename}"),
            os.path.expanduser(f"~/.local/share/whispy/icons/{filename}"),
            f"/usr/local/share/icons/hicolor/scalable/apps/{filename}",
            f"/usr/share/icons/hicolor/scalable/apps/{filename}",
            f"/usr/share/whispy/icons/{filename}",
        ]
        for c in candidates:
            if os.path.isfile(c):
                return c
        return None

    def render_svg_pixmap(self, svg_path, width, height):
        if not svg_path or not os.path.exists(svg_path):
            return []
        try:
            handle = Rsvg.Handle.new_from_file(svg_path)
            pixbuf = handle.get_pixbuf()
            if pixbuf.get_width() != width or pixbuf.get_height() != height:
                pixbuf = pixbuf.scale_simple(width, height, 2)  # INTERP_BILINEAR = 2

            pixels = pixbuf.get_pixels()
            argb = bytearray(len(pixels))
            # Convert RGBA to ARGB big-endian network byte order
            for i in range(0, len(pixels), 4):
                r, g, b, a = pixels[i:i+4]
                argb[i] = a
                argb[i+1] = r
                argb[i+2] = g
                argb[i+3] = b
            return [(width, height, bytes(argb))]
        except Exception as e:
            sys.stderr.write(f"whispy-tray: error rendering {svg_path}: {e}\n")
            return []

    def get_icon_and_tooltip(self, state_str, err_msg=None):
        if state_str == "recording":
            return "whispy-recording", "Whispy: Listening..."
        elif state_str == "transcribing":
            return "whispy-transcribing", "Whispy: Transcribing (GPU)..."
        elif state_str == "error":
            msg = f" ({err_msg})" if err_msg else ""
            return "whispy-error", f"Whispy: Error{msg}"
        else:
            return "whispy-idle", "Whispy: Ready"

    def update_state(self):
        new_state = "idle"
        err_msg = None
        if os.path.exists(self.state_file):
            try:
                with open(self.state_file, "r") as f:
                    data = json.load(f)
                    new_state = data.get("state", "idle")
                    err_msg = data.get("error_message")
            except Exception:
                pass

        if new_state != self.current_state:
            self.current_state = new_state
            self.icon_name, self.tooltip_text = self.get_icon_and_tooltip(new_state, err_msg)
            self.emit_signals()
        return True

    def emit_signals(self):
        if not self.conn:
            return
        self.conn.emit_signal(
            None,
            "/StatusNotifierItem",
            "org.kde.StatusNotifierItem",
            "NewIcon",
            None
        )
        self.conn.emit_signal(
            None,
            "/StatusNotifierItem",
            "org.kde.StatusNotifierItem",
            "NewToolTip",
            None
        )

    def handle_method_call(self, conn, sender, object_path, interface_name, method_name, parameters, invocation):
        if method_name == "Activate":
            # Left click: toggle dictation
            subprocess.Popen(["whispy-client", "toggle"])
        elif method_name == "SecondaryActivate":
            # Middle click: cancel dictation
            subprocess.Popen(["whispy-client", "cancel"])
        elif method_name == "ContextMenu":
            # Right click: toggle dictation
            subprocess.Popen(["whispy-client", "toggle"])
        invocation.return_value(None)

    def handle_get_property(self, conn, sender, object_path, interface_name, property_name):
        if property_name == "Category":
            return GLib.Variant("s", "ApplicationStatus")
        elif property_name == "Id":
            return GLib.Variant("s", "whispy")
        elif property_name == "Title":
            return GLib.Variant("s", "Whispy Dictation")
        elif property_name == "Status":
            return GLib.Variant("s", "Active")
        elif property_name == "IconName":
            return GLib.Variant("s", self.icon_name)
        elif property_name == "IconPixmap":
            pix_data = self.pixmaps.get(self.current_state) or self.pixmaps.get("idle", [])
            return GLib.Variant("a(iiay)", pix_data)
        elif property_name == "IconThemePath":
            return GLib.Variant("s", self.icon_dir)
        elif property_name == "ItemIsMenu":
            return GLib.Variant("b", False)
        elif property_name == "ToolTip":
            return GLib.Variant("(sa(iiay)ss)", ("", [], "Whispy Dictation", self.tooltip_text))
        return None

def main():
    tray = WhispyTray()
    node_info = Gio.DBusNodeInfo.new_for_xml(SNI_XML)
    interface_info = node_info.interfaces[0]

    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    tray.conn = bus

    bus.register_object(
        "/StatusNotifierItem",
        interface_info,
        tray.handle_method_call,
        tray.handle_get_property,
        None
    )

    def register_watcher():
        try:
            bus.call_sync(
                "org.kde.StatusNotifierWatcher",
                "/StatusNotifierWatcher",
                "org.kde.StatusNotifierWatcher",
                "RegisterStatusNotifierItem",
                GLib.Variant("(s)", ("/StatusNotifierItem",)),
                None,
                Gio.DBusCallFlags.NONE,
                2000,
                None
            )
        except Exception as e:
            sys.stderr.write(f"whispy-tray: watcher registration retry: {e}\n")
            return True  # retry
        return False  # registered successfully

    if register_watcher():
        GLib.timeout_add_seconds(3, register_watcher)

    # Initial check
    tray.update_state()

    # Poll state.json every 50ms for responsive state transitions
    GLib.timeout_add(50, tray.update_state)

    loop = GLib.MainLoop()

    def handle_signal(*args):
        loop.quit()

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    loop.run()

if __name__ == "__main__":
    main()
